FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore "Edith.csproj"
RUN dotnet publish "Edith.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

# Render inyecta PORT en tiempo de ejecución; si no esta seteada usamos
# 8080 como default para correrlo local con `docker run`.
ENTRYPOINT ["sh", "-c", "dotnet Edith.dll --urls http://+:${PORT:-8080}"]
